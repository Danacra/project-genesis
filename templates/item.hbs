<section class="genesis-item-editor">
  <header class="genesis-item-header"><img src="{{item.img}}" data-action="editImage" data-edit="img" alt="" title="Изменить изображение"><div><span class="genesis-kicker">PROJECT GENESIS / ИНВЕНТАРЬ</span><h2>{{item.name}}</h2><span class="genesis-muted">{{typeLabel}}</span></div></header>
  <div class="genesis-content"><div class="genesis-panel">
    {{#if isContainer}}
      <label>Максимальная масса (кг)<input data-genesis-field="capacityMass" type="number" min="0" step="0.01" value="{{item.system.capacityMass}}" {{#unless editable}}disabled{{/unless}}></label>
      <label>Максимальный объём (л)<input data-genesis-field="capacityVolume" type="number" min="0" step="0.01" value="{{item.system.capacityVolume}}" {{#unless editable}}disabled{{/unless}}></label>
      <label>Собственная масса (кг)<input data-genesis-field="tareMass" type="number" min="0" step="0.01" value="{{item.system.tareMass}}" {{#unless editable}}disabled{{/unless}}></label>
      <label>Собственный объём (л)<input data-genesis-field="tareVolume" type="number" min="0" step="0.01" value="{{item.system.tareVolume}}" {{#unless editable}}disabled{{/unless}}></label>
    {{else}}
      <label>Количество<input data-genesis-field="quantity" type="number" min="0" step="1" value="{{item.system.quantity}}" {{#unless editable}}disabled{{/unless}}></label>
      <label>Масса одной единицы (кг)<input data-genesis-field="unitMass" type="number" min="0" step="0.01" value="{{item.system.unitMass}}" {{#unless editable}}disabled{{/unless}}></label>
      <label>Объём одной единицы (л)<input data-genesis-field="unitVolume" type="number" min="0" step="0.01" value="{{item.system.unitVolume}}" {{#unless editable}}disabled{{/unless}}></label>
      <label>Код ресурса (food или water)<input data-genesis-field="resourceCode" value="{{item.system.resourceCode}}" {{#unless editable}}disabled{{/unless}}></label>
      <label>Качество<input data-genesis-field="quality" type="number" min="0" max="10" step="1" value="{{item.system.quality}}" {{#unless editable}}disabled{{/unless}}></label>
      <label>Технологический уровень<input data-genesis-field="techTier" type="number" min="0" max="10" step="1" value="{{item.system.techTier}}" {{#unless editable}}disabled{{/unless}}></label>
    {{/if}}
    <label>Описание<textarea data-genesis-field="description" rows="3" {{#unless editable}}disabled{{/unless}}>{{item.system.description}}</textarea></label>
  </div></div><footer class="genesis-footer">PG / INVENTORY</footer>
</section>
