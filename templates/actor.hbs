          <div class="genesis-subtree-header">
            <button type="button" data-genesis-back-to-tree>← Все технологии</button>
            <div><span class="genesis-kicker">PROJECT GENESIS / НАУЧНАЯ ПРОГРАММА</span>
              <h3>{{name}}</h3><p class="genesis-muted">{{description}} Для завершения исследуйте все десять направлений.</p></div>
            <div class="genesis-subtree-counter"><strong>{{done}} / {{total}}</strong><small>ИЗУЧЕНО</small></div>
          </div>
          <div class="genesis-subtree-progress"><span style="width:{{percent}}%"></span></div>
          {{#if complete}}<p class="genesis-tech-done">✓ Программа завершена, её чертежи открыты.</p>{{/if}}
          <div class="genesis-subtree-layout">
            <div class="genesis-subtree-phases" role="group" aria-label="Мини-исследования программы">
              {{#each phases}}
              <section class="genesis-subtree-phase"><header><span>{{name}}</span><small>{{description}}</small></header>
                {{#each nodes}}
                  <button type="button" class="genesis-subtech-card {{#if unlocked}}is-unlocked{{else}}{{#unless prerequisitesReady}}is-locked{{/unless}}{{/if}}" data-genesis-subtech-card="{{id}}" aria-label="{{name}}">
                    <strong>{{name}}</strong><small>{{branchLabel}} · {{statusLabel}}</small>
                    <span class="genesis-subtech-progress"><span style="width:{{percent}}%"></span></span>
                    {{#if parentNames.length}}<em>После: {{#each parentNames}}{{this}}{{#unless @last}}, {{/unless}}{{/each}}</em>{{/if}}
                  </button>
                {{/each}}
              </section>
              {{/each}}
            </div>
            <aside class="genesis-subtree-inspector" aria-label="Детали мини-исследования">
              {{#each details}}
              <section data-genesis-subtech-detail="{{id}}" hidden>
                <span class="genesis-kicker">{{branchLabel}} · МИНИ-ИССЛЕДОВАНИЕ</span>
                <h3>{{name}}</h3><p>{{description}}</p>
                <h4>Результат изучения</h4><p class="genesis-subtech-result">{{result}}</p>
                {{#if unlocked}}<p class="genesis-tech-done">✓ Исследование завершено</p>
                {{else}}
                  <div class="genesis-tech-invest"><strong>{{progress}} / {{rp}} ОИ</strong><progress max="{{rp}}" value="{{progress}}"></progress></div>
                  {{#if parentsNames.length}}<h4>Необходимые открытия</h4><p>{{#each parentsNames}}{{this}}{{#unless @last}}, {{/unless}}{{/each}}</p>{{/if}}
                  {{#if missingParentNames.length}}<p class="genesis-tech-alert">Сначала изучите: {{#each missingParentNames}}{{this}}{{#unless @last}}, {{/unless}}{{/each}}</p>{{/if}}
                  {{#if missingFacilityNames.length}}<p class="genesis-tech-alert">Требуется инфраструктура: {{#each missingFacilityNames}}{{this}}{{#unless @last}}, {{/unless}}{{/each}}</p>{{/if}}
                  {{#unless powerReady}}<p class="genesis-tech-alert">Необходимая инфраструктура обесточена.</p>{{/unless}}
                  {{#if materials.length}}<h4>Материалы для завершения</h4><ul class="genesis-tech-materials">{{#each materials}}<li class="{{#unless ok}}is-missing{{/unless}}"><span>{{name}}</span><strong>{{available}} / {{required}}</strong></li>{{/each}}</ul>{{/if}}
                  {{#if ../../research.canResearch}}
                    {{#if canWork}}<button type="button" class="genesis-primary" data-genesis-action="work" data-tech-id="{{id}}">Исследовать (2d10)</button>{{/if}}
                    {{#if remaining}}<button type="button" data-genesis-action="invest" data-tech-id="{{id}}" {{#unless canInvest}}disabled title="{{investBlockedReason}}"{{/unless}}>Вложить очки</button>{{/if}}
                    {{#if investBlockedReason}}<p class="genesis-tech-alert">{{investBlockedReason}}</p>{{/if}}
                    {{#if canFinish}}<button type="button" class="genesis-primary" data-genesis-action="complete" data-tech-id="{{id}}">Завершить исследование</button>{{/if}}
                  {{/if}}
                {{/if}}
              </section>
              {{/each}}
            </aside>
          </div>
        </div>
        {{/each}}
      </div>
      <div class="genesis-panel"><h3>Научная инфраструктура</h3>
        <p class="genesis-muted">В v0.5 лаборатории и мастерские можно строить во вкладке «Строительство». Ведущий также может вручную отмечать объекты, уже существовавшие в кампании до обновления.</p>
        <div class="genesis-facility-grid">{{#each research.facilities}}
          <div class="genesis-facility {{#if active}}is-active{{/if}}"><span>{{#if active}}✓{{else}}○{{/if}} {{name}}</span>
            {{#if ../isGM}}<button type="button" data-genesis-action="facility" data-facility-id="{{id}}">{{#if active}}Убрать{{else}}Открыть{{/if}}</button>{{/if}}</div>
        {{/each}}</div>
      </div>
      <div class="genesis-panel"><h3>Научный журнал</h3>
        <div class="genesis-log">{{#each research.history}}<article><span>День {{day}}</span><strong>{{techName}}</strong><small>Исследователь: {{by}}</small></article>{{else}}<p class="genesis-muted">Технологических открытий ещё нет.</p>{{/each}}</div>
        <p class="genesis-footnote">Каждый выживший может провести одну исследовательскую работу за игровые сутки. Работа создаёт свободные очки; их можно инвестировать в любые открытые направления.</p>
      </div>
    {{else}}
      <div class="genesis-empty"><h2>Научная программа ещё не создана</h2><p>Ведущий должен создать хотя бы одного актора типа «Колония».</p></div>
    {{/if}}
  </div>
  <div class="genesis-content" data-genesis-page="blueprints" hidden>
