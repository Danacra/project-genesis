        <article class="genesis-job {{#if ready}}is-ready{{/if}}"><div class="genesis-job-main"><strong>{{name}} ×{{amount}}</strong><small>Запустил: {{createdBy}} · День {{startedDay}} · {{storageName}}</small></div>
