<section class="genesis-layout">
  <div class="genesis-banner">
    <div class="genesis-portrait"><img src="{{actor.img}}" data-action="editImage" data-edit="img" alt="" title="Изменить портрет"></div>
    <div class="genesis-heading"><span class="genesis-kicker">PROJECT GENESIS / EXPEDITION ARCHIVE</span>
      <h1>{{actor.name}}</h1><div class="genesis-muted">{{#if isColony}}Колония и общий склад{{else}}Карточка выжившего · {{specialization.name}}{{/if}}</div></div>
    <div class="genesis-header-controls">
      <label class="genesis-header-switcher">Раздел
        <select data-genesis-quick-nav aria-label="Перейти к разделу листа">
          <option value="overview">Обзор</option>
          <option value="inventory">{{#if isColony}}Общий склад{{else}}Инвентарь выжившего{{/if}}</option>
          <option value="containers">Контейнеры</option>
          <option value="research">Исследования</option>
          <option value="blueprints">Чертежи</option>
          <option value="production">Производство</option>
          <option value="construction">Строительство</option>
          <option value="networks">Энергия и сети</option>
          <option value="planet">Планета и погода</option>
          <option value="crew">Экипаж и логистика</option>
          <option value="mission">Космическая программа</option>
          <option value="history">Журнал операций</option>
          <option value="library">Библиотека</option>
        </select>
      </label>
      <button type="button" class="genesis-header-inventory" data-genesis-open-tab="inventory">{{#if isColony}}Общий склад{{else}}Инвентарь{{/if}}</button>
    </div>
    <div class="genesis-day genesis-clock-panel" data-genesis-clock>
      <span class="genesis-clock-caption">ДЕНЬ <b data-genesis-clock-day>{{worldDay}}</b></span>
      <strong data-genesis-clock-time>{{clock.time}}</strong>
      <small data-genesis-clock-state>{{#if clock.paused}}Пауза{{else}}Ход времени · ×{{clock.speed}}{{/if}}</small>
      {{#if clock.canControl}}<div class="genesis-clock-controls" aria-label="Управление игровыми часами">
        <button type="button" data-genesis-clock-toggle aria-pressed="{{#unless clock.paused}}true{{else}}false{{/unless}}">{{#if clock.paused}}▶ Пуск{{else}}❚❚ Пауза{{/if}}</button>
        <label>Скорость<select data-genesis-clock-speed aria-label="Скорость игровых часов">{{#each clock.choices}}<option value="{{value}}" {{#if selected}}selected{{/if}}>{{name}}</option>{{/each}}</select></label>
        <button type="button" data-genesis-clock-hour title="Перейти на один игровой час вперёд">+1 ч</button>
        <button type="button" data-genesis-action="day" title="Ручной переход суток и списание запасов">+1 день</button>
      </div>{{/if}}
    </div>
  </div>
  <div class="genesis-workspace-row">
    <aside class="genesis-sidebar-shell" data-genesis-sidebar aria-label="Навигация PROJECT GENESIS">
      <div class="genesis-sidebar-head"><strong>РАЗДЕЛЫ</strong><button type="button" data-genesis-sidebar-toggle title="Закрепить боковую панель" aria-label="Закрепить боковую панель" aria-pressed="false"><i class="fa-solid fa-thumbtack" aria-hidden="true"></i></button></div>
  <div class="genesis-nav genesis-tabbar" role="tablist" aria-label="Разделы PROJECT GENESIS" data-genesis-navigation>
    <button type="button" data-genesis-tab="overview" role="tab" title="Обзор" aria-label="Обзор"><i class="fa-solid fa-house" aria-hidden="true"></i><span class="genesis-nav-label">Обзор</span></button>
    <button type="button" data-genesis-tab="inventory" role="tab" title="Инвентарь" aria-label="Инвентарь"><i class="fa-solid fa-suitcase" aria-hidden="true"></i><span class="genesis-nav-label">Инвентарь</span></button>
    <button type="button" data-genesis-tab="containers" role="tab" title="Контейнеры" aria-label="Контейнеры"><i class="fa-solid fa-boxes-stacked" aria-hidden="true"></i><span class="genesis-nav-label">Контейнеры</span></button>
    <button type="button" data-genesis-tab="research" role="tab" title="Исследования" aria-label="Исследования"><i class="fa-solid fa-flask" aria-hidden="true"></i><span class="genesis-nav-label">Исследования</span></button>
    <button type="button" data-genesis-tab="blueprints" role="tab" title="Чертежи" aria-label="Чертежи"><i class="fa-solid fa-book-open" aria-hidden="true"></i><span class="genesis-nav-label">Чертежи</span></button>
    <button type="button" data-genesis-tab="production" role="tab" title="Производство" aria-label="Производство"><i class="fa-solid fa-gears" aria-hidden="true"></i><span class="genesis-nav-label">Производство</span></button>
    <button type="button" data-genesis-tab="construction" role="tab" title="Строительство" aria-label="Строительство"><i class="fa-solid fa-hammer" aria-hidden="true"></i><span class="genesis-nav-label">Строительство</span></button>
    <button type="button" data-genesis-tab="networks" role="tab" title="Энергия и сети" aria-label="Энергия и сети"><i class="fa-solid fa-bolt" aria-hidden="true"></i><span class="genesis-nav-label">Энергия и сети</span></button>
    <button type="button" data-genesis-tab="planet" role="tab" title="Планета" aria-label="Планета"><i class="fa-solid fa-globe" aria-hidden="true"></i><span class="genesis-nav-label">Планета</span></button>
    <button type="button" data-genesis-tab="crew" role="tab" title="Экипаж и логистика" aria-label="Экипаж и логистика"><i class="fa-solid fa-users" aria-hidden="true"></i><span class="genesis-nav-label">Экипаж и логистика</span></button>
    <button type="button" data-genesis-tab="mission" role="tab" title="Корабль" aria-label="Корабль"><i class="fa-solid fa-rocket" aria-hidden="true"></i><span class="genesis-nav-label">Корабль</span></button>
    <button type="button" data-genesis-tab="history" role="tab" title="Журнал операций" aria-label="Журнал операций"><i class="fa-solid fa-clock-rotate-left" aria-hidden="true"></i><span class="genesis-nav-label">Журнал операций</span></button>
    <button type="button" data-genesis-tab="library" role="tab" title="Библиотека" aria-label="Библиотека"><i class="fa-solid fa-book" aria-hidden="true"></i><span class="genesis-nav-label">Библиотека</span></button>
  </div>
    </aside>
    <div class="genesis-workspace-body">
  <div class="genesis-content" data-genesis-page="overview">
    <div class="genesis-library-shortcut"><button type="button" data-genesis-help-open="start">? С чего начать</button></div>
    {{#if isColony}}
      <div class="genesis-panel"><h2>Колония</h2><div class="genesis-form-grid">
        <label>Биом<input data-genesis-field="biome" value="{{actor.system.biome}}" {{#unless editable}}disabled{{/unless}}></label>
        <label>Предел массы, кг<input type="number" data-genesis-field="capacity.mass" value="{{actor.system.capacity.mass}}" min="0" step="0.01" {{#unless editable}}disabled{{/unless}}></label>
        <label>Предел объёма, л<input type="number" data-genesis-field="capacity.volume" value="{{actor.system.capacity.volume}}" min="0" step="0.01" {{#unless editable}}disabled{{/unless}}></label>
        <div class="genesis-summary-metric"><small>Технологический уровень</small><strong>{{actor.system.science.tier}}</strong></div>
        <div class="genesis-summary-metric"><small>Свободные очки исследований</small><strong>{{actor.system.science.points}}</strong></div>
      </div></div>
    {{else}}
      <div class="genesis-panels-2">
        <div class="genesis-panel"><h2>Шесть характеристик <span class="genesis-hint">нажмите ◇ для проверки</span></h2>
        {{#each abilities}}<div class="genesis-stat-row"><span>{{label}}</span><input type="number" data-genesis-field="abilities.{{key}}" value="{{value}}" min="1" max="10" step="1" {{#unless ../editable}}disabled{{/unless}}><button type="button" data-genesis-action="roll" data-ability="{{key}}" title="Бросить 2d10">◇</button></div>{{/each}}
        </div>
        <div class="genesis-panel"><h2>Навыки <span class="genesis-hint">0–6</span></h2>
        {{#each skills}}<div class="genesis-stat-row"><span>{{label}}</span><input type="number" data-genesis-field="skills.{{key}}" value="{{value}}" min="0" max="6" step="1" {{#unless ../editable}}disabled{{/unless}}></div>{{/each}}
        </div>
      </div>
      <div class="genesis-panel"><h2>Состояние экспедиции</h2><div class="genesis-vitals">
      {{#each vitals}}<label class="genesis-vital"><span>{{label}}</span><progress value="{{value}}" max="100"></progress><input type="number" data-genesis-field="survival.{{key}}" value="{{value}}" min="0" max="100" step="1" {{#unless ../editable}}disabled{{/unless}}></label>{{/each}}
      </div><p class="genesis-footnote">Голод, жажда и усталость: 0 — лучшее состояние, 100 — критическое. Здоровье и кислород: 100 — максимум.</p></div>
      {{#if isSurvivor}}<div class="genesis-panel genesis-specialization-panel">
        <h2>Специализация персонажа</h2>
        <div class="genesis-specialization-status"><span>{{#if specialization.hasSpecialization}}ТЕКУЩАЯ СПЕЦИАЛИЗАЦИЯ{{else}}СПЕЦИАЛИЗАЦИЯ ЕЩЁ НЕ ПОЛУЧЕНА{{/if}}</span><strong>{{specialization.name}}</strong></div>
        <p class="genesis-muted">Определяется автоматически: основная характеристика не ниже 6, профильный навык не ниже 4. Пока специализации только информационные — бонусы появятся в будущих обновлениях.</p>
        <div class="genesis-specialization-grid">{{#each specialization.all}}
          <article class="genesis-specialization-item {{#if ready}}is-ready{{/if}}">
            <div><strong>{{name}}{{#if ready}} · ✓{{/if}}</strong><small>{{abilityName}} {{ability}}/6 · {{skillName}} {{skill}}/4</small></div>
            <progress max="100" value="{{progress}}" aria-label="Прогресс специализации {{name}}"></progress>
            <p>{{future}}</p>
          </article>{{/each}}</div>
      </div>
      <div class="genesis-panel"><h2>Отдых и восстановление</h2>
        <p class="genesis-muted">Отдых доступен один раз за игровые сутки. Новые рабочие задания заблокированы при усталости от 85.</p>
        <p>Усталость: <strong>{{rest.fatigue}} / 100</strong> · {{#if rest.shelter}}На базе есть жилой модуль{{else}}Жилой модуль ещё не построен{{/if}}</p>
        {{#if rest.used}}<p class="genesis-tech-done">Сегодня персонаж уже отдыхал.</p>{{/if}}
        {{#if rest.busy}}<p class="genesis-tech-alert">Персонаж занят рабочим заданием — завершите его перед отдыхом.</p>{{/if}}
        <div class="genesis-network-actions">
          <button type="button" data-genesis-action="rest" data-rest-kind="field" {{#unless rest.canAct}}disabled{{/unless}} {{#if rest.used}}disabled{{/if}} {{#if rest.busy}}disabled{{/if}}>Полевой отдых (−22 усталости)</button>
          <button type="button" class="genesis-primary" data-genesis-action="rest" data-rest-kind="shelter" {{#unless rest.canAct}}disabled{{/unless}} {{#unless rest.shelter}}disabled{{/unless}} {{#if rest.used}}disabled{{/if}} {{#if rest.busy}}disabled{{/if}}>Сон в жилом модуле (−40 усталости)</button>
        </div>
      </div>{{/if}}
      <div class="genesis-panel"><h2>Профиль</h2><div class="genesis-profile-specialization"><span>Автоматическая специализация</span><strong>{{specialization.name}}</strong><small>Повышайте характеристики и навыки, чтобы открыть профиль. Записанное ранее значение сохраняется в данных персонажа.</small></div>
        <label>Биография<textarea data-genesis-field="biography" rows="3" {{#unless editable}}disabled{{/unless}}>{{actor.system.biography}}</textarea></label></div>
    {{/if}}
    <div class="genesis-panel genesis-inventory-summary">
      <div><h2>{{#if isColony}}Общий склад колонии{{else}}Личный инвентарь выжившего{{/if}}</h2>
      <p class="genesis-muted">Масса {{load.mass}} / {{cap.mass}} кг · Объём {{load.volume}} / {{cap.volume}} л · Предметов {{totalItems}}</p></div>
      <button type="button" class="genesis-primary" data-genesis-open-tab="inventory">{{#if isColony}}Открыть склад{{else}}Открыть инвентарь{{/if}}</button>
    </div>
    <div class="genesis-panel"><h2>Журнал исследователя</h2><textarea data-genesis-field="notes" rows="3" placeholder="Открытия, важные наблюдения, задачи..." {{#unless editable}}disabled{{/unless}}>{{actor.system.notes}}</textarea></div>
  </div>
  <div class="genesis-content" data-genesis-page="inventory" hidden>
    <div class="genesis-library-shortcut"><button type="button" data-genesis-help-open="inventory">? Как устроен инвентарь</button></div>
    <div class="genesis-toolbar"><div><h2>{{#if isColony}}Общий склад колонии{{else}}Личный инвентарь выжившего{{/if}}</h2><p class="genesis-muted">Материалы и оборудование · учёт массы и объёма</p></div>
      {{#if editable}}<button type="button" data-genesis-action="create" class="genesis-primary">+ Добавить предмет</button>{{/if}}</div>
    <div class="genesis-capacity"><span><strong>{{load.mass}}</strong> / {{cap.mass}} кг</span><span><strong>{{load.volume}}</strong> / {{cap.volume}} л</span><span>{{totalItems}} ед.</span></div>
    <div class="genesis-tablewrap"><table class="genesis-table"><thead><tr><th>Название</th><th>Количество</th><th>Масса</th><th>Объём</th><th>Место</th><th></th></tr></thead>
      <tbody>{{#each items}}<tr><td><div class="genesis-item-name"><img src="{{img}}" alt=""><span><strong>{{name}}</strong><small>{{kind}}{{#if resourceCode}} · {{resourceCode}}{{/if}}</small></span></div></td>
      <td>{{quantity}}</td><td>{{mass}} кг</td><td>{{volume}} л</td><td>{{location}}</td><td class="genesis-actions"><button type="button" data-genesis-action="open-item" data-item-id="{{id}}" title="Открыть">✎</button><button type="button" data-genesis-action="transfer" data-item-id="{{id}}" title="Передать / переложить">⇢</button></td></tr>{{else}}<tr><td colspan="6" class="genesis-empty">Пока пусто. Добавьте материалы или снаряжение.</td></tr>{{/each}}
    </tbody></table></div>
  </div>
  <div class="genesis-content" data-genesis-page="containers" hidden>
    <div class="genesis-library-shortcut"><button type="button" data-genesis-help-open="inventory">? Как устроены хранилища</button></div>
    <div class="genesis-toolbar"><div><h2>Хранилища и контейнеры</h2><p class="genesis-muted">Нельзя вложить контейнер в другой контейнер</p></div>
      {{#if editable}}<button type="button" data-genesis-action="container" class="genesis-primary">+ Создать контейнер</button>{{/if}}</div>
    <div class="genesis-container-grid"><article class="genesis-container-card"><h3>Основной отсек</h3><div>{{load.mass}} / {{cap.mass}} кг</div><div>{{load.volume}} / {{cap.volume}} л</div></article>
      {{#each containers}}<article class="genesis-container-card"><h3>{{name}}</h3><div>{{used.mass}} / {{mass}} кг</div><div>{{used.volume}} / {{volume}} л</div><button type="button" data-genesis-action="open-item" data-item-id="{{id}}">Настроить</button></article>{{/each}}</div>
    <p class="genesis-footnote">Для перемещения в контейнер откройте вкладку «Инвентарь» и нажмите ⇢ напротив предмета.</p>
  </div>
  <div class="genesis-content genesis-research-page" data-genesis-page="research" hidden>
    <div class="genesis-library-shortcut"><button type="button" data-genesis-help-open="research">? Как проводить исследования</button></div>
    {{#if research.available}}
      <div class="genesis-research-header">
        <div><span class="genesis-kicker">PROJECT GENESIS / SCIENCE & DISCOVERY</span><h2>Древо технологий</h2>
          <p class="genesis-muted">Общая научная программа «{{research.colonyName}}». Открытия сохраняются в колонии.</p></div>
        <div class="genesis-research-metrics"><div><strong>{{research.science.points}}</strong><small>Свободных ОИ</small></div><div><strong>{{research.progressCount}} / {{#if isGM}}{{research.techCount}}{{else}}?{{/if}}</strong><small>Изучено</small></div>
          {{#if isGM}}<button type="button" data-genesis-action="grant" title="Начисление очков ведущим">+ Начислить ОИ</button>{{/if}}
        </div>
      </div>
      <div class="genesis-programme-overview" aria-label="Научные программы первого этапа">
        {{#each research.programmes}}
        <article class="genesis-field-entry">
          <div><strong>{{name}}</strong><span>{{done}} / {{total}} мини-исследований · {{#if complete}}Завершено{{else}}В процессе{{/if}}</span></div>
          <div class="genesis-programme-track"><span style="width:{{percent}}%"></span></div>
          <button type="button" class="genesis-primary" data-genesis-open-subtree="{{id}}">{{#if complete}}Просмотреть{{else}}Открыть программу{{/if}} →</button>
        </article>
        {{/each}}
      </div>
      <div data-genesis-research-main>
      <div class="genesis-era-rail" role="group" aria-label="Эпохи экспедиции" data-genesis-era-nav>
        {{#each research.eras}}
          <button type="button" data-genesis-era-jump="{{tier}}" title="Перейти к эпохе {{label}}">
            <span class="genesis-era-number">НАУЧНАЯ ЭПОХА</span><strong>{{label}}</strong>
          </button>
        {{/each}}
      </div>
      <div class="genesis-tech-toolbar">
        <div class="genesis-tech-filters"><button type="button" data-genesis-tech-filter="all" class="active">Все направления</button>
          {{#each research.branches}}<button type="button" data-genesis-tech-filter="{{id}}">{{label}}</button>{{/each}}</div>
        <div class="genesis-tech-toolrow"><input type="search" data-genesis-tech-search placeholder="Найти технологию..." aria-label="Поиск технологии">
          <button type="button" data-genesis-action="zoom-out" title="Уменьшить">−</button>
          <span class="genesis-zoom" data-genesis-zoom-level>100%</span>
          <button type="button" data-genesis-action="zoom-in" title="Увеличить">+</button>
          <button type="button" data-genesis-action="zoom-reset" title="Исходный масштаб">↺</button>
          <button type="button" data-genesis-era-home title="Вернуться в начало дерева">К началу</button></div>
          <p class="genesis-tech-controls-hint">Перетаскивайте поле мышью, переходите по эпохам, выбирайте технологии. Зажмите Shift и прокрутите колесо для горизонтального перемещения.</p>
      </div>
      <div class="genesis-tech-layout">
        <div class="genesis-tech-viewport" role="region" aria-label="Интерактивное дерево открытий" tabindex="0">
          <div class="genesis-tech-board" data-genesis-tech-board>
            <svg data-genesis-tech-links class="genesis-tech-links" aria-hidden="true"></svg>
            {{#each research.eras}}
            <div class="genesis-tech-era" data-genesis-era="{{tier}}"><h3><span class="genesis-era-head-mark">◇</span> {{label}}</h3>
              {{#each nodes}}
              <button type="button" class="genesis-tech-card {{#if isGroup}}genesis-tech-group{{/if}} {{#if unlocked}}is-unlocked{{else}}{{#unless prerequisitesReady}}is-locked{{/unless}}{{/if}}" data-genesis-tech-card="{{id}}" data-genesis-tech-branch="{{branch}}" aria-label="{{name}}">
                <span class="genesis-tech-card-label"><span class="genesis-tech-branch-glyph" aria-hidden="true"></span> {{branchLabel}}</span><strong>{{name}}</strong>
                <span class="genesis-tech-card-status">{{statusLabel}}</span>
                <span class="genesis-tech-progress"><span style="width:{{percent}}%"></span></span>
              </button>
              {{/each}}
            </div>
            {{/each}}
          </div>
        </div>
        <aside class="genesis-tech-inspector" aria-label="Подробности исследования">
          <div class="genesis-tech-inspector-heading"><span>НАУЧНОЕ ДОСЬЕ</span><small>Выберите технологию на схеме</small></div>
          <p class="genesis-muted" data-genesis-tech-empty hidden>По заданному фильтру технологии не найдены.</p>
          {{#each research.details}}
          <section data-genesis-tech-detail="{{id}}" hidden>
            <span class="genesis-kicker">{{branchLabel}} · ЭПОХА {{epochDisplay}}</span><h3>{{name}}</h3>
            <p class="genesis-muted">{{description}}</p>
            {{#if isGroup}}<div class="genesis-survey-inspector"><strong>Составная научная программа</strong>
              <p>Для открытия «{{name}}» необходимо завершить все 10 внутренних исследований. Каждое требует собственных очков исследований и соответствующих условий.</p>
              <p><strong>{{progress}} / {{required}}</strong> открыто</p>
              <button type="button" class="genesis-primary" data-genesis-open-subtree="{{id}}">Перейти к мини-исследованиям →</button>
              </div>{{/if}}
            {{#if unlocked}}
              <p class="genesis-tech-done">✓ Технология изучена колонией</p>
            {{else}}
              {{#unless isGroup}}
              <div class="genesis-tech-invest"><strong>{{progress}} / {{rp}} ОИ</strong><progress max="{{rp}}" value="{{progress}}"></progress></div>
              {{#if parentsNames.length}}<h4>Предыдущие исследования</h4>
                <p>{{#each parentsNames}}{{this}}{{#unless @last}} · {{/unless}}{{/each}}</p>{{/if}}
              {{#if missingParentNames.length}}<p class="genesis-tech-alert">Требуются: {{#each missingParentNames}}{{this}}{{#unless @last}}, {{/unless}}{{/each}}</p>{{/if}}
              {{#if requiredFacilityNames.length}}<h4>Оборудование</h4><p>{{#each requiredFacilityNames}}{{this}}{{#unless @last}}, {{/unless}}{{/each}}</p>{{/if}}
              {{#if missingFacilityNames.length}}<p class="genesis-tech-alert">Отсутствует: {{#each missingFacilityNames}}{{this}}{{#unless @last}}, {{/unless}}{{/each}}</p>{{/if}}
              {{#unless powerReady}}<p class="genesis-tech-alert">Требуемая инфраструктура обесточена. Проверьте раздел «Энергия и сети».</p>{{/unless}}
              {{#if materials.length}}<h4>Материалы на открытие</h4>
                <ul class="genesis-tech-materials">{{#each materials}}<li class="{{#unless ok}}is-missing{{/unless}}"><span>{{name}}</span><strong>{{available}} / {{required}}</strong></li>{{/each}}</ul>
                <small class="genesis-muted">Материалы списываются со склада колонии только при завершении открытия.</small>{{/if}}
              {{#if ../research.canResearch}}
                {{#if canWork}}<button type="button" class="genesis-primary" data-genesis-action="work" data-tech-id="{{id}}">Исследовать (2d10)</button>{{/if}}
                {{#if remaining}}
                  <button type="button" data-genesis-action="invest" data-tech-id="{{id}}" {{#unless canInvest}}disabled title="{{investBlockedReason}}"{{/unless}}>Вложить очки</button>
                  {{#if investBlockedReason}}<p class="genesis-tech-alert" role="status">{{investBlockedReason}}</p>{{/if}}
                {{/if}}
                {{#if canFinish}}<button type="button" class="genesis-primary" data-genesis-action="complete" data-tech-id="{{id}}">Завершить открытие</button>{{/if}}
                {{#unless remaining}}<p class="genesis-muted">Финансирование завершено. Выполните остальные требования.</p>{{/unless}}
              {{/if}}
              {{/unless}}
            {{/if}}
            {{#unless isGroup}}<h4>Открываемые чертежи</h4>
            <ul>{{#each recipesNames}}<li>{{this}}</li>{{/each}}</ul>{{/unless}}
          </section>
          {{/each}}
