      <div class="genesis-tech-legend" aria-label="Условные обозначения">
        <span><i class="is-unlocked"></i> Изучено</span>
        <span><i class="is-ready"></i> Доступно</span>
        <span><i class="is-locked"></i> Требует открытий</span>
      </div>
      </div><!-- /data-genesis-research-main -->
