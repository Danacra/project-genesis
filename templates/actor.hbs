        <article class="genesis-map-row"><span class="genesis-map-symbol">{{#if isFinished}}◆{{else}}◇{{/if}}</span><div><strong>{{name}}</strong><small>{{sceneName}} · {{#if isFinished}}Построено{{else}}Стройплощадка{{/if}} · ({{x}}, {{y}})</small></div>
          {{#unless mapOk}}<small class="genesis-map-warning">⚠ {{mapProblem}}</small>{{/unless}}
